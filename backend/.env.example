APP_NAME="Food Spot API"
APP_ENV=development

# Database configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foodspot_db

# Security & JWT
JWT_SECRET_KEY=foodspot_dev_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Queue & Cache
REDIS_URL=redis://127.0.0.1:6379/0

# External AI Service
# Dùng mock AI server local: http://127.0.0.1:8001/api/v1/extract
# Trong Docker Compose: http://mock-ai:8001/api/v1/extract
AI_SERVER_EXTRACT_URL=http://127.0.0.1:8001/api/v1/extract
AI_REQUEST_TIMEOUT=180

# ArcGIS Geocoding Service
ARCGIS_GEOCODE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
ARCGIS_REVERSE_GEOCODE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/reverseGeocode
